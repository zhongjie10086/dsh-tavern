diff --git a/sidebar-patched/src/client/host-sessions.ts b/src/client/host-sessions.ts
new file mode 100644
index 0000000..32e6476
--- /dev/null
+++ b/src/client/host-sessions.ts
@@ -0,0 +1,60 @@
+import type { Context, SidebarSessionList, SidebarSessionsService, SidebarSubagentAddress, SidebarSubagentCatalog } from '../context-types.ts'
+// Compatibility with legacy selection and the explicit-reference Session controller.
+export function sidebarCurrentSession(list: SidebarSessionList): string | undefined {
+  if (Object.prototype.hasOwnProperty.call(list, "current")) return list.current;
+  return Object.values(list.byId).find(row => (row.retainedBy?.mainView ?? 0) > 0)?.id;
+}
+export function sidebarCatalogs(list: SidebarSessionList): Record<string, SidebarSubagentCatalog> {
+  if (list.subagentsByParent !== undefined) return list.subagentsByParent;
+  const projections = list.projectionsBySession ?? {};
+  return Object.fromEntries(Object.entries(projections).map(([parentId, projection]) => [parentId, {
+    state: projection.state === "idle" ? projection.values?.subagentCatalog === undefined ? "loading" : "ready" : projection.state,
+    error: projection.error ?? null,
+    parentAvailable: list.byId[parentId] !== undefined,
+    entries: (projection.values?.subagentCatalog ?? []).map(entry => {
+      if (entry.mode === "unknown") return { kind: "diagnostic", id: entry.id, reason: "unsupported" };
+      const children = projections[entry.id]?.values?.subagentCatalog;
+      return { ...entry, mode: entry.mode, kind: "child", activity: list.byId[entry.id]?.running ? "running" : "inactive",
+        hasChildren: children === undefined || children.length > 0 };
+    })
+  }]));
+}
+export function sidebarObserveCatalog(sessions: SidebarSessionsService, parentId: string, open: boolean) {
+  if (typeof sessions.refreshProjections === "function") {
+    // Projection pushes are owned by the controller, not by this panel's lifetime.
+    if (open) return sessions.refreshProjections(parentId);
+  } else sessions.setSubagentCatalogOpen?.(parentId, open);
+}
+export function sidebarRefreshCatalog(sessions: SidebarSessionsService, parentId: string) {
+  return typeof sessions.refreshProjections === "function" ? sessions.refreshProjections(parentId) : sessions.refreshSubagents?.(parentId);
+}
+export function sidebarOpenSession(ctx: Context, target: string | SidebarSubagentAddress) {
+  if (typeof ctx.sessions.retain === "function") {
+    const workspace = ctx.get("uiWorkspace") as { openSession?(target: string | SidebarSubagentAddress): void } | undefined;
+    if (typeof workspace?.openSession !== "function") throw new Error("main-view navigation service is unavailable");
+    workspace.openSession(target);
+  } else if (typeof target === "string") {
+    if (typeof ctx.sessions.open !== "function") throw new Error("session navigation is unavailable");
+    ctx.sessions.open(target);
+  } else {
+    if (typeof ctx.sessions.openSubagent !== "function") throw new Error("subagent navigation is unavailable");
+    ctx.sessions.openSubagent(target);
+  }
+}
+export async function sidebarSaveFork(ctx: Context, threadId: string, title: string) {
+  if (!ctx.sessions.fork) throw new Error("session fork is unavailable");
+  const newId = await ctx.sessions.fork({ sessionId: threadId, increaseTitle: true });
+  if (typeof ctx.sessions.retain === "function") {
+    const reference = ctx.sessions.retain(newId, { source: "controllerOperation" });
+    try {
+      await reference.ready;
+      if (title !== "") await reference.binding.session.rename(title);
+      sidebarOpenSession(ctx, newId);
+    } finally { reference.release(); }
+  } else {
+    const binding = ctx.sessions.binding?.(newId);
+    if (binding !== undefined && title !== "") await binding.session.rename(title);
+    sidebarOpenSession(ctx, newId);
+  }
+  return newId;
+}
